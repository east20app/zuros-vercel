{
  "name": "zuros-platform",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "check:secrets": "node scripts/check-secrets.cjs",
    "clean:dev": "node scripts/clean-dev-cache.cjs",
    "predev": "node scripts/ensure-site.cjs build",
    "prepack": "npm run check:secrets",
    "dev:fresh": "npm run dev",
    "dev": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=384 tsx src/index.ts",
    "dev:site": "npm --prefix site run dev",
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=384 tsx src/index.ts",
    "start:site": "npm --prefix site run start",
    "prestart": "node scripts/ensure-site.cjs build",
    "postinstall": "node scripts/ensure-site.cjs install",
    "build": "npm install && cd site && npm install && npm run build && cd .. && tsc",
    "build:site": "node scripts/build-site.cjs",
    "lint": "npm --prefix site run lint",
    "typecheck": "tsc --noEmit && npm --prefix site run typecheck",
    "deploy:zip": "node scripts/create-deploy-zip.cjs",
    "install:all": "npm install && cd site && npm install"
  },
  "author": "",
  "license": "ISC",
  "description": "ZUROS BOT + ZUROS APP",
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bytes": "^3.1.5",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/semver": "^7.7.0",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^2.10.3",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@camposcloud/sdk": "^1.1.3",
    "@discordjs/voice": "^0.19.0",
    "@napi-rs/canvas": "^1.0.3",
    "adm-zip": "^0.6.0",
    "axios": "^1.7.4",
    "bytes": "^3.1.2",
    "chart.js": "^4.5.0",
    "cross-env": "^10.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "fast-discord-js": "^1.1.0",
    "ignore": "^7.0.5",
    "mongoose": "^8.7.0",
    "next": "^15.5.21",
    "postcss": "^8.5.23",
    "qrcode": "^1.5.4",
    "qrcode-pix": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sdk-node-apis-efi": "^1.2.25",
    "semver": "^7.7.2",
    "sharp": "^0.35.0",
    "tsx": "^4.23.12",
    "wio.db": "^4.0.22",
    "zod": "^3.23.8"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}

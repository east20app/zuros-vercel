{
  "name": "zuros-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify && next build",
    "build:next": "next build",
    "verify": "npm run typecheck && npm run lint",
    "lint": "eslint . --max-warnings 0",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@camposcloud/sdk": "^1.1.3",
    "adm-zip": "^0.6.0",
    "axios": "^1.7.4",
    "chart.js": "^4.5.1",
    "dotenv": "^16.4.5",
    "mongoose": "^8.7.0",
    "next": "^15.5.21",
    "next-auth": "^4.24.7",
    "qrcode": "^1.5.4",
    "qrcode-pix": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sdk-node-apis-efi": "^1.2.25",
    "sharp": "^0.35.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}

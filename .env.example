# URL pública do processo único bot + painel, sem barra final
APP_URL=https://seu-dominio.com
NEXTAUTH_URL=https://seu-dominio.com
NEXTAUTH_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Banco, bot gerenciador e OAuth do Discord
MONGO_DB_URL=mongodb+srv://usuario:senha@cluster/banco
# Opcional: necessário somente se o worker Discord legado também for iniciado
# BOT_TOKEN=
OWNER_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Webhooks de pagamento (segredos exclusivos, nunca use NEXT_PUBLIC_*)
EFI_WEBHOOK_SECRET=
EFI_WEBHOOK_URL=https://seu-dominio.com/api/webhooks/efi
PROMISSEPAY_WEBHOOK_SECRET=
PROMISSEPAY_WEBHOOK_URL=https://seu-dominio.com/api/webhooks/promissepay

# Banco separado usado pelas instancias DROX (database: drox_bots)
DROX_BOTS_MONGO_URI=${MONGO_DB_URL}
